<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipeRefresh"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <ProgressBar
        android:id="@+id/progressBar"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:max="100"
        android:progressTint="#2FC5B3" />

    <!-- 사용법 안내 진입점 - 톱니(설정) 버튼 바로 왼쪽에 둔다. -->
    <TextView
        android:id="@+id/helpBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="58dp"
        android:background="@drawable/settings_btn_bg"
        android:clickable="true"
        android:elevation="2dp"
        android:focusable="true"
        android:gravity="center"
        android:text="?"
        android:textColor="#08796F"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- 오더퀸 자동등록 설정 진입점 - 앱 전용 기능이라 웹페이지 쪽이 아니라
         네이티브 화면 한쪽에 고정 버튼으로 둔다. 이모지 대신 벡터 톱니
         아이콘을 써서 기기에 따라 흐리게/얇게 보이던 문제를 없앤다. -->
    <ImageView
        android:id="@+id/settingsBtn"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="14dp"
        android:layout_marginEnd="10dp"
        android:background="@drawable/settings_btn_bg"
        android:clickable="true"
        android:contentDescription="@string/settings_button_description"
        android:elevation="2dp"
        android:focusable="true"
        android:padding="9dp"
        android:src="@drawable/ic_settings_gear" />

    <!-- 코치마크 튜토리얼("?" 버튼)이 뜰 자리 - 평소엔 숨겨져 있다가
         CoachMarkTutorial이 이 프레임 안에 스포트라이트/선/설명 텍스트를
         직접 그려 넣는다. 항상 마지막 자식이어야 다른 모든 뷰 위에 그려진다. -->
    <FrameLayout
        android:id="@+id/coachMarkRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone" />

</FrameLayout>
